<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme sáng (Light) với tone màu đỏ; không dùng chế độ tối để màu luôn nhất quán. -->
    <style name="Base.Theme.BTH2" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/red_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/red_light</item>
        <item name="colorOnPrimaryContainer">@color/red_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.BTH2" parent="Base.Theme.BTH2" />

    <!-- Nhãn nhỏ phía trên Spinner / DatePicker ở màn hình thêm khoản chi -->
    <style name="AddLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Nhãn nhỏ (Danh mục, Ngày chi tiêu, Ghi chú) ở màn hình chi tiết -->
    <style name="DetailLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Giá trị hiển thị bên dưới nhãn -->
    <style name="DetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>